PORT=8080
NODE_ENV=development

# ==========================================
# WHITE-LABEL BRANDING CONFIGURATION
# ==========================================
BRAND_NAME="Your Company Name"
BRAND_TAGLINE="Fast & Reliable Package Tracking"
BRAND_SUPPORT_EMAIL="support@yourcompany.com"

# Set to "true" to hide underlying courier name and display your brand
HIDE_CARRIER_PROVIDER=true

# ==========================================
# PROVIDER CONFIGURATION
# ==========================================
DEFAULT_PROVIDER="flightgo"

# Set to "true" only for offline testing / demo fixtures.
# When false (production), unknown numbers return a clean 404 error instead of fake data.
ENABLE_MOCK=false

# ==========================================
# COURIER CREDENTIALS
# ==========================================

# FlightGo Express
FLIGHTGO_API_KEY=""
FLIGHTGO_USERNAME=""
FLIGHTGO_PASSWORD=""

# Air Cargo Logistics (Bearer Token)
CARGO_API_BASE_URL=""
CARGO_BEARER_TOKEN=""

# QuickShip Express
QUICKSHIP_API_BASE_URL="https://qsapi.quickshipnow.com"
QUICKSHIP_API_KEY=""

# ==========================================
# SECURITY & RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
ALLOWED_ORIGINS="*"
